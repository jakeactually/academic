<% content_for :title, "Dashboard" %>

<h1 class="h3 mb-4">Dashboard</h1>

<p class="mb-4">You are signed in as <strong><%= current_user.email %></strong>. Role: <span class="badge <%= bootstrap_role_badge_class(current_user.role) %>"><%= current_user.role.humanize %></span></p>

<% if current_user.admin? %>
  <h2 class="h4 mb-3 border-bottom pb-2 mt-4 text-primary">Main Resources</h2>
  <div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-4 mb-5">
    <div class="col">
      <%= link_to admin_careers_path, class: "card h-100 text-center text-decoration-none shadow-sm card-hover border-primary border-opacity-25" do %>
        <div class="card-body py-4">
          <i class="bi bi-briefcase fs-1 text-primary mb-3 d-block"></i>
          <h3 class="card-title h6 mb-0 text-dark">Careers</h3>
        </div>
      <% end %>
    </div>
    <div class="col">
      <%= link_to admin_teachers_path, class: "card h-100 text-center text-decoration-none shadow-sm card-hover border-primary border-opacity-25" do %>
        <div class="card-body py-4">
          <i class="bi bi-person-video3 fs-1 text-primary mb-3 d-block"></i>
          <h3 class="card-title h6 mb-0 text-dark">Teachers</h3>
        </div>
      <% end %>
    </div>
    <div class="col">
      <%= link_to admin_students_path, class: "card h-100 text-center text-decoration-none shadow-sm card-hover border-primary border-opacity-25" do %>
        <div class="card-body py-4">
          <i class="bi bi-mortarboard fs-1 text-primary mb-3 d-block"></i>
          <h3 class="card-title h6 mb-0 text-dark">Students</h3>
        </div>
      <% end %>
    </div>
    <div class="col">
      <%= link_to admin_subjects_path, class: "card h-100 text-center text-decoration-none shadow-sm card-hover border-primary border-opacity-25" do %>
        <div class="card-body py-4">
          <i class="bi bi-book fs-1 text-primary mb-3 d-block"></i>
          <h3 class="card-title h6 mb-0 text-dark">Subjects</h3>
        </div>
      <% end %>
    </div>
    <div class="col">
      <%= link_to admin_classrooms_path, class: "card h-100 text-center text-decoration-none shadow-sm card-hover border-primary border-opacity-25" do %>
        <div class="card-body py-4">
          <i class="bi bi-building fs-1 text-primary mb-3 d-block"></i>
          <h3 class="card-title h6 mb-0 text-dark">Classrooms</h3>
        </div>
      <% end %>
    </div>
  </div>

  <h2 class="h4 mb-3 border-bottom pb-2 text-secondary">Other Resources</h2>
  <div class="row row-cols-2 row-cols-md-2 row-cols-lg-4 g-4 mb-4">
    <div class="col">
      <%= link_to admin_career_subjects_path, class: "card h-100 text-center text-decoration-none shadow-sm card-hover border-secondary border-opacity-25" do %>
        <div class="card-body py-4">
          <i class="bi bi-bookmark-star fs-1 text-secondary mb-3 d-block"></i>
          <h3 class="card-title h6 mb-0 text-dark">Assign subjects to careers</h3>
        </div>
      <% end %>
    </div>
    <div class="col">
      <%= link_to admin_teacher_subjects_path, class: "card h-100 text-center text-decoration-none shadow-sm card-hover border-secondary border-opacity-25" do %>
        <div class="card-body py-4">
          <i class="bi bi-person-workspace fs-1 text-secondary mb-3 d-block"></i>
          <h3 class="card-title h6 mb-0 text-dark">Assign subjects to teachers</h3>
        </div>
      <% end %>
    </div>
    <div class="col">
      <%= link_to admin_dependent_subjects_path, class: "card h-100 text-center text-decoration-none shadow-sm card-hover border-secondary border-opacity-25" do %>
        <div class="card-body py-4">
          <i class="bi bi-diagram-3 fs-1 text-secondary mb-3 d-block"></i>
          <h3 class="card-title h6 mb-0 text-dark">Dependencies</h3>
        </div>
      <% end %>
    </div>
    <div class="col">
      <%= link_to admin_course_classes_path, class: "card h-100 text-center text-decoration-none shadow-sm card-hover border-secondary border-opacity-25" do %>
        <div class="card-body py-4">
          <i class="bi bi-calendar3 fs-1 text-secondary mb-3 d-block"></i>
          <h3 class="card-title h6 mb-0 text-dark">Classes</h3>
        </div>
      <% end %>
    </div>
  </div>
<% elsif current_user.teacher? %>
  <% if @teacher.nil? %>
    <div class="alert alert-warning">
      We couldn't find a teacher record matching your email (<strong><%= current_user.email %></strong>). Please contact administration.
    </div>
  <% else %>
    <div class="card mb-4 border-success shadow-sm">
      <div class="card-header bg-success text-white">
        <strong>Teacher Information</strong>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-6">
            <strong>Name:</strong> <%= @teacher.name %>
          </div>
        </div>
      </div>
    </div>

    <h2 class="h5 mb-3">My Schedule</h2>
    <% if @assigned_classes.any? %>
      <%= render "schedule_grid", schedule_classes: @schedule_classes, role: :teacher %>
    <% else %>
      <div class="alert alert-info">You do not have any assigned classes yet.</div>
    <% end %>
  <% end %>

<% elsif current_user.student? %>
  <% if @student.nil? %>
    <div class="alert alert-warning">
      We couldn't find a student record matching your email (<strong><%= current_user.email %></strong>). Please contact administration.
    </div>
  <% else %>
    <div class="card mb-4 border-info shadow-sm">
      <div class="card-header bg-info text-white">
        <strong>Student Information</strong>
      </div>
      <div class="card-body">
        <div class="row">
          <div class="col-md-4">
            <strong>Name:</strong> <%= @student.name %>
          </div>
          <div class="col-md-4">
            <strong>Career:</strong> <%= @student.career.name %>
          </div>
          <div class="col-md-4">
            <strong>Semester:</strong> <%= @student.semester %>
          </div>
        </div>
      </div>
    </div>

    <h2 class="h5 mb-3">My Schedule</h2>
    <% if @taken_classes.any? %>
      <%= render "schedule_grid", schedule_classes: @schedule_classes, role: :student %>
    <% else %>
      <div class="alert alert-info">You are not enrolled in any classes yet.</div>
    <% end %>

    <h2 class="h5 mb-3 mt-5">Currently Enrolled Classes</h2>
    <div class="card shadow-sm border-0 mb-4">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-4">Subject</th>
                <th>Teacher</th>
                <th>Classroom</th>
                <th>Time (Day/Hour)</th>
                <th class="text-end pe-4">Action</th>
              </tr>
            </thead>
            <tbody>
              <% if @taken_classes.any? %>
                <% @taken_classes.each do |c| %>
                  <tr>
                    <td class="ps-4"><%= c.teacher_subject.subject.name %></td>
                    <td><%= c.teacher_subject.teacher.name %></td>
                    <td><%= c.classroom.name %></td>
                    <td><%= c.weekday %> / <%= "%02d:00" % c.dayhour %></td>
                    <td class="text-end pe-4">
                      <%= button_to "Drop", drop_class_path(c), method: :delete, form: { data: { turbo_confirm: 'Drop this class?' } }, class: "btn btn-sm btn-outline-danger" %>
                    </td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="5" class="text-center text-muted py-4">You are not enrolled in any classes yet.</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <h2 class="h5 mb-3 mt-5">Available Classes (Semester <%= @student.semester %>)</h2>
    <div class="card shadow-sm border-0">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-4">Subject</th>
                <th>Teacher</th>
                <th>Classroom</th>
                <th>Time (Day/Hour)</th>
                <th class="text-end pe-4">Action</th>
              </tr>
            </thead>
            <tbody>
              <% if @available_classes.any? %>
                <% @available_classes.each do |c| %>
                  <tr>
                    <td class="ps-4"><%= c.teacher_subject.subject.name %></td>
                    <td><%= c.teacher_subject.teacher.name %></td>
                    <td><%= c.classroom.name %></td>
                    <td><%= c.weekday %> / <%= c.dayhour %></td>
                    <td class="text-end pe-4">
                      <%= button_to "Enroll", enroll_class_path(c), method: :post, class: "btn btn-sm btn-primary" %>
                    </td>
                  </tr>
                <% end %>
              <% else %>
                <tr>
                  <td colspan="5" class="text-center text-muted py-4">No more available classes for your semester.</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
